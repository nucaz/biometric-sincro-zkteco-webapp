# Copy to .env (never commit the real .env -- it has real secrets) and
# fill in. docker-compose.yml reads this automatically from the project
# root.

POSTGRES_USER=asistencia
POSTGRES_PASSWORD=cambia-esto-por-una-clave-fuerte
POSTGRES_DB=asistencia

# Firma las cookies de sesión -- genera una propia, no reuses esta:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-tambien

# Puerto donde el panel queda expuesto en el host (http://localhost:WEB_PORT)
WEB_PORT=5000

# Puerto donde PostgreSQL queda expuesto en el host -- necesario para que
# un agente remoto de otra sede (central/remote_agent.py) se conecte por
# VPN. Si ninguna sede usa agente remoto, podés comentar "ports:" del
# servicio "db" en docker-compose.yml para no exponerlo.
POSTGRES_PORT=5432

# Cuándo corre la sincronización automática -- deja SYNC_DAILY_AT y borra
# SYNC_INTERVAL_MINUTES para "una vez al día a esa hora" (lo que ya corre
# en el Windows de producción hoy), o al revés para "cada N minutos" (lo
# que corre en el systemd de Linux). Los botones "Sincronizar" del panel
# funcionan al instante sin importar esto.
SYNC_DAILY_AT=23:00
SYNC_INTERVAL_MINUTES=
